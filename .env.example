# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Published by .github/workflows/container.yml. Image names must be lowercase.
EH_DOWNLOADER_IMAGE=ghcr.io/yeraph-plus/eh-downloader:latest

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
SECURE_COOKIES=false
DEFAULT_RETENTION_DAYS=7
DEFAULT_CACHE_LIMIT_BYTES=21474836480
DEFAULT_MAX_ARCHIVE_SIZE_MB=4096
DEFAULT_WORKER_CONCURRENCY=2
TZ=Asia/Shanghai

# Leave empty for a direct connection. Docker Desktop host proxy example:
# EH_PROXY_URL=http://host.docker.internal:10808
EH_PROXY_URL=

# Optional H@H service. Uncomment these together with the H@H block in compose.yaml.
# HATH_IMAGE=ghcr.io/yeraph-plus/eh-downloader:hath
# HATH_CLIENT_ID=12345
# HATH_CLIENT_KEY=replace-with-client-key
# HATH_PORT=65432
# HATH_JAVA_OPTIONS=-Xms128m -Xmx512m
