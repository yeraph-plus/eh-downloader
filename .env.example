# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Published by .github/workflows/container.yml
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# Optional: set to true when serving over a HTTPS reverse proxy
SECURE_COOKIES=false
# Bootstrap defaults for the settings page. 0 means unlimited/permanent:
# retention 0 keeps caches forever, a 0 cache limit or archive size limit
# disables the cap. All three are editable in the Settings page later.
DEFAULT_RETENTION_DAYS=0
DEFAULT_CACHE_LIMIT_BYTES=0
DEFAULT_MAX_ARCHIVE_SIZE_MB=0
DEFAULT_WORKER_CONCURRENCY=2

# Optional H@H service. Uncomment these together with the H@H block in compose.yaml.
# HATH_CLIENT_ID=12345
# HATH_CLIENT_KEY=your-client-key
# HATH_PORT=65432
# HATH_JAVA_OPTIONS=-Xms128m -Xmx512m

# Site integration (Aiya Core `aiya/integrations/v1`): site-account sign-in
# and credit billing. The master switch below must be true AND both the
# base URL and the service key set; with the switch off the core access
# mode hides entirely and only guest/admin modes remain.
#AIYA_CORE_ENABLED=false
#AIYA_CORE_BASE_URL=https://cms.example.com
#AIYA_CORE_SERVICE_KEY=the-key-from-the-sites-file-serve-page
#AIYA_CORE_SESSION_COOKIE=aiya_session
